#!/usr/bin/env bash
# fclaude-vscode — Claude process wrapper for the VS Code extension (plan §11).
#
# Point the extension's `claudeCode.claudeProcessWrapper` setting at this script.
# It ensures the VM is up, mounts the workspace folder (the extension launches us
# with cwd = workspace root), and runs the real `claude` inside the VM with stdio
# forwarded over `ssh -T`. The mount is reference-counted and released when this
# process exits.
#
# NOTE: this wrapper does NOT pass --dangerously-skip-permissions. The extension
# exposes that as its own setting; enable it there.
set -euo pipefail

FCLAUDE_LIB_DIR="${FCLAUDE_LIB_DIR:-$HOME/.local/lib/fclaude}"
# shellcheck source=../../lib/common.sh
source "${FCLAUDE_LIB_DIR}/common.sh"

load_config
ensure_vm_running

DIR="$PWD"

# The extension invokes us as:
#   fclaude-vscode <path-to-bundled-claude> <claude-flags...>
# argv[1] is the extension's own claude binary on the *host* (not reachable in
# the VM). It is byte-identical to the VM's native claude, so we discard it and
# run the VM's claude with the remaining flags forwarded verbatim.
(($#)) && shift
extra=""
(($#)) && extra="$(printf '%q ' "$@")"

# Workspace-agnostic helper invocations (MCP servers) must NOT mount a workspace.
# The extension runs *every* claude process through this wrapper, including
# long-lived MCP helpers like the claude-in-chrome server. Those don't touch
# workspace files, and the chrome MCP in particular is a per-extension-host
# singleton that outlives the editing session — mounting for it pins (leaks) the
# first workspace's NFS mount until VS Code restarts. Detect those and run in the
# VM home with no mount. The discriminator is fail-open: unrecognized invocations
# still mount, preserving behaviour for the real editing session.
fc_is_mcp_helper() {
  [[ "${1:-}" == "mcp" ]] && return 0   # `claude mcp serve|list|…`
  local a
  for a in "$@"; do
    [[ "$a" == "--claude-in-chrome-mcp" ]] && return 0
  done
  return 1
}

if fc_is_mcp_helper "$@"; then
  # No mount, no workspace cd, nothing to release: exec straight through.
  # Workspace-agnostic helpers (chrome-MCP singleton) are NOT routed through
  # Headroom — they aren't coding sessions and shouldn't carry wrap's startup.
  exec ssh -T \
    -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR "${SSH_USER}@${VM_IP}" \
    "${CLAUDE_LOGIN_ENV} exec claude ${extra}"
fi

# The workspace must be under the shared root; otherwise we refuse to run (the
# extension would have no usable mount). We do NOT exec, so the EXIT trap can
# release the mount afterwards. The relpath check runs in a subshell so its
# die() can't abort this wrapper before we reach our own error message.
if abs="$(cd "$DIR" 2>/dev/null && pwd -P)" && (relpath_under_home "$abs") >/dev/null 2>&1; then
  mount_workspace "$abs"
  trap 'unmount_workspace "$abs"' EXIT
  # Route through Headroom via `headroom-quiet wrap` (banner on stderr, so the
  # extension's stdout JSON protocol stays clean).
  # cd into the SAME absolute path the host uses. In the VM /home/<hostuser> is a
  # bind mount of /home/fclaude, so the host cwd resolves to the mounted
  # workspace AND getcwd reports it under /home/<hostuser> (a symlink would be
  # canonicalized back to /home/fclaude) — claude returns host-matching paths.
  ssh -T \
    -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR "${SSH_USER}@${VM_IP}" \
    "${CLAUDE_LOGIN_ENV} cd $(printf '%q' "$abs") && exec $(_headroom_launch) ${extra}"
else
  die "workspace ${DIR} is not under ${SHARE_ROOT}; refusing to run (open a folder under your \$HOME)"
fi
