#!/usr/bin/env bash
# fclaude — run Claude Code in yolo mode inside the sandbox VM (plan §10).
#
#   fclaude [options] [-- claude-args...]
#
# Default: ensure the VM is up, mount the current directory into the VM
# (reference counted), run `claude --dangerously-skip-permissions` there, and
# unmount on exit.
set -euo pipefail

FCLAUDE_LIB_DIR="${FCLAUDE_LIB_DIR:-$HOME/.local/lib/fclaude}"
# shellcheck source=../../lib/common.sh
source "${FCLAUDE_LIB_DIR}/common.sh"

usage() {
  cat <<'EOF'
Usage: fclaude [options] [-- claude-args...]

Options:
  --dir <path>       Mount and run in <path> instead of the current directory.
  --no-mount         Run claude in the VM home with nothing mounted.
  --mount <dir>...   Mount the given directories into the VM and hold them until
                     Ctrl+C (then unmount). Does not start claude. Useful when
                     you want a workspace visible in the VM for something else.
  -m, --maintenance  Open an interactive shell in the VM as the maintenance user.
  -s, --status       Print VM state, resources, and active workspaces (no start).
  --cleanup <ws>     Force-unmount one stuck workspace and clear its refcount.
                     <ws> is a path as shown by --status (e.g. projects/foo) or
                     a directory under your $HOME. Use when a leaked session left
                     a mount behind. Does not start the VM.
  --update           Update Claude Code + system packages in the VM now (ignores
                     the weekly run's network-speed gate), then exit.
  --shutdown         Power off the VM (asks for confirmation), then exit.
  -h, --help         Show this help.

Anything after `--` (or any unrecognized trailing args) is passed to claude.
The target directory must be under your $HOME and is shared at the same relative
path under /home/fclaude in the VM.

At session start, fclaude warns if the last successful update is older than
FCLAUDE_UPDATE_WARN_DAYS (default 15) — a reminder that the auto-updater or the
weekly apt timer may have stalled. Clear it with `fclaude --update`.
EOF
}

DIR="$PWD"
DO_MOUNT=1
declare -a CLAUDE_ARGS=()
declare -a MOUNT_DIRS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir)           DIR="${2:?--dir needs a path}"; shift 2 ;;
    --no-mount)      DO_MOUNT=0; shift ;;
    --mount)         MODE_MOUNT=1; shift
                     # Greedy: consume every following non-option word as a dir.
                     while [[ $# -gt 0 && "$1" != -* ]]; do MOUNT_DIRS+=("$1"); shift; done ;;
    -m|--maintenance) MODE_MAINT=1; shift ;;
    -s|--status)     MODE_STATUS=1; shift ;;
    --cleanup)       MODE_CLEANUP=1; CLEANUP_TARGET="${2:?--cleanup needs a workspace path}"; shift 2 ;;
    --update)        MODE_UPDATE=1; shift ;;
    --shutdown)      MODE_SHUTDOWN=1; shift ;;
    -h|--help)       usage; exit 0 ;;
    --)              shift; CLAUDE_ARGS+=("$@"); break ;;
    *)               CLAUDE_ARGS+=("$1"); shift ;;
  esac
done

load_config

# --- One-shot modes -------------------------------------------------------
if [[ -n "${MODE_STATUS:-}" ]]; then
  ( set +e; fclaude_status )
  exit 0
fi

if [[ -n "${MODE_CLEANUP:-}" ]]; then
  # Resolve the target to a relpath under $SHARE_ROOT. Accept an existing
  # directory (abs or relative to CWD) or a bare relpath as --status prints it.
  if [[ -d "$CLEANUP_TARGET" ]]; then
    rel="$(relpath_under_home "$CLEANUP_TARGET")"
  else
    rel="$CLEANUP_TARGET"
  fi
  cleanup_workspace "$rel"
  exit 0
fi

if [[ -n "${MODE_UPDATE:-}" ]]; then
  fclaude_update
  exit $?
fi

if [[ -n "${MODE_SHUTDOWN:-}" ]]; then
  if [[ "$(vm_state)" != "running" ]]; then
    info "VM $VM_NAME is not running."
    exit 0
  fi
  read -rp "Shut down the fclaude VM '$VM_NAME'? [y/N] " ans
  if [[ "$ans" == [yY] ]]; then
    virsh shutdown "$VM_NAME" >/dev/null && info "shutdown signal sent."
  else
    info "cancelled."
  fi
  exit 0
fi

if [[ -n "${MODE_MAINT:-}" ]]; then
  ensure_vm_running
  ssh_maint
  exit $?
fi

if [[ -n "${MODE_MOUNT:-}" ]]; then
  ((${#MOUNT_DIRS[@]})) || die "--mount needs at least one directory"

  # Resolve and validate everything first, so a bad path fails before any mount.
  declare -a MOUNT_ABS=()
  declare -A MOUNT_SEEN=()
  for d in "${MOUNT_DIRS[@]}"; do
    abs="$(cd "$d" 2>/dev/null && pwd -P)" || die "directory does not exist: $d"
    rel="$(relpath_under_home "$abs")"
    [[ "$rel" == "." ]] && die "refusing to share all of $SHARE_ROOT; pick a subdirectory"
    # Skip repeats — the same dir named twice would only inflate its refcount.
    if [[ -z "${MOUNT_SEEN[$abs]:-}" ]]; then
      MOUNT_SEEN[$abs]=1
      MOUNT_ABS+=("$abs")
    fi
  done

  ensure_vm_running

  # Release, in reverse order, whatever we managed to mount — including when a
  # mount partway through the list fails.
  declare -a HELD=()
  # shellcheck disable=SC2317  # invoked indirectly by the EXIT trap below
  release_held() {
    local i
    for ((i = ${#HELD[@]} - 1; i >= 0; i--)); do
      unmount_workspace "${HELD[i]}" || true
    done
  }
  trap release_held EXIT

  for abs in "${MOUNT_ABS[@]}"; do
    mount_workspace "$abs"
    HELD+=("$abs")
    info "  $abs -> ${VM_MOUNT_BASE%/}/$(relpath_under_home "$abs")"
  done

  info "${#HELD[@]} workspace(s) mounted. Press Ctrl+C to unmount and exit."

  # Idle until interrupted. `wait` on a backgrounded sleep is interruptible, so
  # the trap fires immediately instead of at the end of a sleep interval.
  hold_stop=0
  trap 'hold_stop=1' INT TERM
  while ((hold_stop == 0)); do
    sleep 86400 &
    sleep_pid=$!
    wait "$sleep_pid" 2>/dev/null || true
    kill "$sleep_pid" 2>/dev/null || true
  done

  info "unmounting…"
  exit 0
fi

# --- Normal run -----------------------------------------------------------
ensure_vm_running

# Warn (best-effort) if updates have silently stalled — never blocks the session.
( set +e; fclaude_staleness_warn ) || true
# If a newer Headroom is staged and no session is running, activate it now.
( set +e; headroom_activate_if_idle ) || true

extra=""
if ((${#CLAUDE_ARGS[@]})); then
  extra="$(printf '%q ' "${CLAUDE_ARGS[@]}")"
fi

# `cd … || exit 1;` rather than `cd … && exec …`: a `;`-separated tokensave sync
# sits between them, and with `&&` only the FIRST command would be guarded — a
# failed cd would still exec claude, in the wrong directory.
if [[ "$DO_MOUNT" == 1 ]]; then
  rel="$(relpath_under_home "$DIR")"
  abs="$(cd "$DIR" && pwd -P)"
  mount_workspace "$abs"
  trap 'unmount_workspace "$abs"' EXIT
  ssh_vm_tty "${CLAUDE_LOGIN_ENV} cd ${VM_MOUNT_BASE%/}/${rel} || exit 1; $(_tokensave_sync_cmd) exec $(_headroom_launch "$abs") --dangerously-skip-permissions ${extra}"
else
  # No workspace mounted: nothing to index, so no tokensave sync.
  ssh_vm_tty "${CLAUDE_LOGIN_ENV} cd ${VM_MOUNT_BASE} || exit 1; exec $(_headroom_launch "$VM_MOUNT_BASE") --dangerously-skip-permissions ${extra}"
fi
