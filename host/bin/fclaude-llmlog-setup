#!/usr/bin/env bash
# fclaude-llmlog-setup — stand-alone installer for the llm.log proxy bridge.
#
# Run with sudo from a repo checkout:  sudo ./host/bin/fclaude-llmlog-setup
#
# Sets up (and is safe to re-run) the host-side bridge that lets claude in the VM
# reach the host's llm.log proxy WITHOUT per-session ssh -R tunnels:
#
#   1. host: a socket-activated systemd unit listens on the libvirt gateway
#      (HOST_IP:PORT) and proxies to llm.log on 127.0.0.1:PORT.
#   2. VM:   /etc/environment's HTTPS_PROXY is pointed at HOST_IP:PORT instead of
#      127.0.0.1:PORT (idempotent), so the guest reaches the bridge over the NAT.
#
# This avoids the multi-session hang: ssh -R installs a single exclusive listener
# in the VM, so concurrent sessions collide and the listener's owner blocks on
# exit waiting for the other session's forwarded connections to drain.
set -euo pipefail

[[ "$(id -u)" -eq 0 ]] || { echo "run with sudo (needs to install systemd units)" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
SOCKET_TMPL="${REPO_DIR}/host/systemd/fclaude-llmlog.socket"
SERVICE_TMPL="${REPO_DIR}/host/systemd/fclaude-llmlog.service"
[[ -r "$SOCKET_TMPL" && -r "$SERVICE_TMPL" ]] \
  || { echo "unit templates not found under ${REPO_DIR}/host/systemd — run from the repo" >&2; exit 1; }

# Resolve the invoking user's config (sudo makes $HOME root's home).
real_user="${SUDO_USER:-$USER}"
real_home="$(getent passwd "$real_user" | cut -d: -f6)"
cfg="${real_home}/.fclaude/config"
[[ -r "$cfg" ]] || { echo "config not found at $cfg — run install.sh first" >&2; exit 1; }
# shellcheck disable=SC1090
source "$cfg"

PORT="${LLMLOG_PROXY_PORT:-}"
[[ -n "$PORT" ]] || { echo "LLMLOG_PROXY_PORT is empty in $cfg — llm.log integration is disabled" >&2; exit 1; }
: "${HOST_IP:?HOST_IP missing from config}"
: "${VM_IP:?VM_IP missing from config}"
: "${SSH_USER:?SSH_USER missing from config}"
: "${SSH_KEY:?SSH_KEY missing from config}"

# Locate systemd-socket-proxyd (path differs across distros / usrmerge).
PROXYD=""
for p in /usr/lib/systemd/systemd-socket-proxyd /lib/systemd/systemd-socket-proxyd; do
  [[ -x "$p" ]] && { PROXYD="$p"; break; }
done
[[ -n "$PROXYD" ]] || { echo "systemd-socket-proxyd not found (install the 'systemd' package)" >&2; exit 1; }

render() {  # <template> <dest>
  sed -e "s|__FCLAUDE_HOST_IP__|${HOST_IP}|g" \
      -e "s|__FCLAUDE_LLMLOG_PORT__|${PORT}|g" \
      -e "s|__FCLAUDE_SOCKET_PROXYD__|${PROXYD}|g" \
      "$1" >"$2"
}

echo "[fclaude-llmlog-setup] host bridge ${HOST_IP}:${PORT} -> 127.0.0.1:${PORT} (proxyd: ${PROXYD})"
render "$SOCKET_TMPL"  /etc/systemd/system/fclaude-llmlog.socket
render "$SERVICE_TMPL" /etc/systemd/system/fclaude-llmlog.service
systemctl daemon-reload
# A re-run must pick up template changes: restart the socket if already present.
systemctl enable fclaude-llmlog.socket >/dev/null
systemctl restart fclaude-llmlog.socket

# Verify the bridge is actually listening on the gateway.
if ss -tlnH "sport = :${PORT}" 2>/dev/null | grep -q "${HOST_IP}:${PORT}"; then
  echo "[fclaude-llmlog-setup] bridge listening on ${HOST_IP}:${PORT}"
else
  echo "[fclaude-llmlog-setup] WARN: nothing listening on ${HOST_IP}:${PORT} — is the libvirt network up?" >&2
fi

# Point the VM's proxy env at the gateway (idempotent: rewrite any loopback form).
echo "[fclaude-llmlog-setup] updating VM /etc/environment proxy -> ${HOST_IP}:${PORT}"
if sudo -u "$real_user" ssh -n \
    -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR -o ConnectTimeout=5 "${SSH_USER}@${VM_IP}" \
    "sudo sed -i -E 's#(https?_proxy|HTTPS?_PROXY)=http://127\\.0\\.0\\.1:${PORT}#\\1=http://${HOST_IP}:${PORT}#g' /etc/environment"; then
  echo "[fclaude-llmlog-setup] VM proxy env updated (new sessions pick it up; existing ssh sessions keep old env)"
else
  echo "[fclaude-llmlog-setup] WARN: could not update VM /etc/environment (VM down?). Re-run, or fix it via: fclaude -m" >&2
fi

echo "[fclaude-llmlog-setup] done."
