# ~/.fclaude/config — fclaude runtime configuration
#
# Sourced by the wrapper scripts. Edit to taste, then restart sessions.
# This file is rendered from host/config.template at install time.

# --- Disk ---
FCLAUDE_DISK="__FCLAUDE_DISK__"

# --- Workspace sharing ---
# $SHARE_ROOT/a/b on the host is shared as $VM_MOUNT_BASE/a/b in the VM.
SHARE_ROOT="__HOME__"
VM_MOUNT_BASE="__FCLAUDE_VM_HOME__"

# --- VM identity / connection ---
VM_NAME="__FCLAUDE_VM_NAME__"
VM_IP="__FCLAUDE_VM_IP__"
HOST_IP="__FCLAUDE_HOST_IP__"
VM_MEM_GIB="__FCLAUDE_VM_MEM_GIB__"
VM_VCPU="__FCLAUDE_VM_VCPU__"

SSH_USER="__FCLAUDE_VM_USER__"
MAINT_USER="__FCLAUDE_MAINT_USER__"
SSH_KEY="__FCLAUDE_SSH_KEY__"
SSH_KEY_MAINT="__FCLAUDE_SSH_KEY_MAINT__"

# --- Host state paths ---
FCLAUDE_HOME="__FCLAUDE_HOME__"
EXPORTS_ROOT="__FCLAUDE_EXPORTS_ROOT__"
REFCOUNT_DIR="__FCLAUDE_REFCOUNT_DIR__"

# --- Automatic updates ---
# Claude Code updates itself via the native installer's background auto-updater
# (latest channel); nothing here controls that. These govern the OPTIONAL weekly
# apt/system upgrade timer in the VM and the session-start staleness warning.
#   FCLAUDE_UPDATE_APT       1 = weekly apt upgrade in the VM; 0 = disable it.
#   FCLAUDE_UPDATE_MIN_MBIT  skip the weekly run if the VM's measured downlink is
#                            slower than this (Mbit/s) — so mobile/travel networks
#                            aren't clogged. 0 disables the gate. `fclaude --update`
#                            always bypasses it.
#   FCLAUDE_UPDATE_PROBE_*   the size/time-capped speed probe used for the gate.
#   FCLAUDE_UPDATE_WARN_DAYS `fclaude` warns at startup if the last SUCCESSFUL apt
#                            upgrade (or Claude version bump) is older than this.
# Re-apply changed knobs to the VM with: ./host/bin/fclaude-update-setup
FCLAUDE_UPDATE_APT="__FCLAUDE_UPDATE_APT__"
FCLAUDE_UPDATE_MIN_MBIT="__FCLAUDE_UPDATE_MIN_MBIT__"
FCLAUDE_UPDATE_PROBE_URL="__FCLAUDE_UPDATE_PROBE_URL__"
FCLAUDE_UPDATE_PROBE_MAXTIME="__FCLAUDE_UPDATE_PROBE_MAXTIME__"
FCLAUDE_UPDATE_WARN_DAYS="__FCLAUDE_UPDATE_WARN_DAYS__"

# --- Headroom proxy (in-VM) ---
# Claude is launched via `headroom wrap claude` so its API traffic runs through
# the in-VM Headroom compression proxy. 0 = run plain claude (bypass Headroom).
FCLAUDE_HEADROOM_ENABLE="__FCLAUDE_HEADROOM_ENABLE__"
FCLAUDE_HEADROOM_PORT="__FCLAUDE_HEADROOM_PORT__"
# Model to run with the 1M context window through Headroom (`--1m` sets
# ANTHROPIC_MODEL=<this>[1m], which overrides settings.json). Empty = no --1m.
FCLAUDE_HEADROOM_MODEL="__FCLAUDE_HEADROOM_MODEL__"

# --- Grafana Cloud metrics (in-VM prometheus agent) ---
# The agent scrapes Headroom /metrics every 5m and remote_writes to Grafana
# Cloud (creds from the SOPS secret). Labels are non-secret. 0 disables.
# Re-apply the secret/config to the VM with: ./host/bin/fclaude-metrics-setup
FCLAUDE_METRICS_ENABLE="__FCLAUDE_METRICS_ENABLE__"
FCLAUDE_METRICS_HOST_LABEL="__FCLAUDE_METRICS_HOST_LABEL__"
FCLAUDE_METRICS_VM_LABEL="__FCLAUDE_METRICS_VM_LABEL__"
