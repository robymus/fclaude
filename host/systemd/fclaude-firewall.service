[Unit]
Description=fclaude host firewall (restrict VM access to host privileged ports)
# The libvirt bridge must exist before our rules reference it. Order after the
# libvirt + nftables services only — NOT network-online.target (host uplink,
# unrelated to the bridge, and part of the boot-time ordering cycle above).
After=libvirtd.service nftables.service
Wants=libvirtd.service
PartOf=libvirtd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/fclaude/fclaude.nft
ExecReload=/usr/sbin/nft -f /etc/fclaude/fclaude.nft
ExecStop=/usr/sbin/nft delete table inet fclaude

[Install]
WantedBy=multi-user.target
