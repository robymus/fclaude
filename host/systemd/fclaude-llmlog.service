[Unit]
Description=fclaude llm.log proxy bridge (forward VM gateway to host loopback)
Requires=fclaude-llmlog.socket
After=fclaude-llmlog.socket

[Service]
# Socket-activated: systemd hands us the listening socket and we proxy every
# connection to llm.log on host loopback (llm.log binds 127.0.0.1 hard-coded).
# One instance multiplexes all concurrent connections, so any number of fclaude
# sessions share it cleanly — no per-session ssh -R, no exclusive listener, and
# nothing to wait for when a session exits.
ExecStart=__FCLAUDE_SOCKET_PROXYD__ 127.0.0.1:__FCLAUDE_LLMLOG_PORT__

# It only needs loopback TCP and no privileges.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
