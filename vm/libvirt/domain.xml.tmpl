<domain type='kvm'>
  <name>__FCLAUDE_VM_NAME__</name>
  <uuid>__FCLAUDE_VM_UUID__</uuid>
  <memory unit='GiB'>__FCLAUDE_VM_MEM_GIB__</memory>
  <currentMemory unit='GiB'>__FCLAUDE_VM_MEM_GIB__</currentMemory>
  <vcpu placement='static'>__FCLAUDE_VM_VCPU__</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <!-- Named CPU model, NOT host-passthrough: on AMD Zen4 (and similar new parts)
       passing the raw host CPU through corrupts the guest (random multi-process
       segfaults / reserved-bit page faults, traced to AVX-512). A KVM-validated
       named model (default EPYC-Milan, no AVX-512) is stable. See FCLAUDE_VM_CPU_MODEL. -->
  <cpu mode='custom' match='exact' check='none'><model fallback='allow'>__FCLAUDE_VM_CPU_MODEL__</model></cpu>
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native' discard='unmap'/>
      <source file='__FCLAUDE_DISK__'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='__FCLAUDE_SEED__'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
    <interface type='network'>
      <source network='__FCLAUDE_LIBVIRT_NET__'/>
      <mac address='__FCLAUDE_VM_MAC__'/>
      <model type='virtio'/>
    </interface>
    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
    <memballoon model='virtio'/>
  </devices>
</domain>
