[Unit]
Description=fclaude metrics agent (Headroom /metrics -> Grafana Cloud, prometheus agent mode)
After=network-online.target fclaude-headroom.service
Wants=network-online.target
# Only run once the config + token have been delivered by fclaude-metrics-setup.
ConditionPathExists=/etc/fclaude/prometheus.yml
ConditionPathExists=/etc/fclaude/gc_token

[Service]
User=fclaude
Group=fclaude
ExecStart=/usr/local/bin/prometheus --agent \
  --config.file=/etc/fclaude/prometheus.yml \
  --storage.agent.path=/var/lib/fclaude/prom-agent \
  --web.listen-address=127.0.0.1:9099
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
