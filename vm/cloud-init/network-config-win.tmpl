# cloud-init NoCloud network configuration (netplan v2) — Windows host variant.
# Used by the experimental Windows host tooling only; the KVM host uses
# network-config.tmpl. Two NICs, each pinned by MAC, so it is hypervisor-neutral:
#   nat0  — NAT: internet access (DHCP from the hypervisor's NAT service).
#   host0 — host-only network: static address the Windows host reaches over ssh.
#           No gateway/DNS/router advertisements here, so the default route
#           stays on the NAT NIC.
# The MTU is chosen per hypervisor by the host tooling: VMware's NAT is a
# userspace TCP proxy that ignores a smaller guest MSS, so VMware needs 1500
# (with 1400 every HTTPS handshake hangs).
version: 2
ethernets:
  nat0:
    match:
      macaddress: "__FCLAUDE_VM_MAC_NAT__"
    set-name: "nat0"
    dhcp4: true
    dhcp6: false
    mtu: __FCLAUDE_VM_MTU__
  host0:
    match:
      macaddress: "__FCLAUDE_VM_MAC_HOSTONLY__"
    set-name: "host0"
    dhcp4: false
    dhcp6: false
    accept-ra: false
    addresses: ["__FCLAUDE_VM_IP__/__FCLAUDE_HOSTONLY_PREFIX__"]
    mtu: __FCLAUDE_VM_MTU__
