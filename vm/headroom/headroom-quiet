#!/opt/headroom/current/bin/python
"""headroom-quiet — run the Headroom CLI with its Click banner on STDERR.

`headroom wrap` prints a startup banner to stdout, which corrupts stdio JSON
protocols (the VS Code claudeProcessWrapper). The banner is emitted via
click.echo/secho; redirecting those to stderr keeps stdout clean for the wrapped
tool's protocol while still launching Claude normally (Claude's own stdout is not
Click output). The shebang points at /opt/headroom/current so it tracks the
active version across updates.
"""
import click

for _name in ("echo", "secho"):
    _orig = getattr(click, _name)

    def _make(orig):
        def _quiet(*args, **kwargs):
            kwargs.setdefault("err", True)  # banner -> stderr; stdout stays clean
            return orig(*args, **kwargs)
        return _quiet

    setattr(click, _name, _make(_orig))

from headroom.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
